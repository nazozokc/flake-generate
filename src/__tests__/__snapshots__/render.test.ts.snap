// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderFlake > renders a grouped, readable flake 1`] = `
"# Generated by flake-generate. Edit freely.
# Detected: Node.js (pnpm-lock.yaml, tsconfig.json)

{
  description = "demo development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
  };

  outputs = inputs@{ self, nixpkgs, flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [
        "aarch64-darwin"
        "aarch64-linux"
        "x86_64-darwin"
        "x86_64-linux"
      ];

      perSystem = { system, ... }:
        let
          pkgs = nixpkgs.legacyPackages.\${system};
        in
        {
          devShells.default = pkgs.mkShell {
            name = "demo";
            packages = [
              # Node.js
              pkgs.nodejs_24
              pkgs.pnpm
              pkgs.typescript
            ];
            shellHook = ''
              echo "[devShell:default] ready"
            '';
          };
        };
    };
}
"
`;

exports[`renderFlake > renders an empty devShell when nothing is detected 1`] = `
