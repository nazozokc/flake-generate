        "x86_64-linux"
      ];

      perSystem = { system, ... }:
        let
          pkgs = nixpkgs.legacyPackages.\${system};
        in
        {
          devShells.default = pkgs.mkShell {
            name = "empty";
            packages = [
              # No ecosystem detected; add packages here.
            ];
            shellHook = ''
              echo "[devShell:default] ready"
            '';
          };
        };
    };
}
"
`;
