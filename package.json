{
  "name": "flake-generate",
  "version": "0.3.0",
  "description": "Analyze a project directory and generate a clean, editable flake.nix",
  "type": "module",
  "bin": {
    "flake-generate": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nazozokc/flake-generate.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:flake": "bash scripts/check-generated-flake.sh",
    "test:package": "bash scripts/check-npm-package.sh",
    "version:check": "node scripts/check-version.mjs",
    "version:sync": "node scripts/check-version.mjs --sync",
    "lint": "biome check .",
    "fmt": "biome check --write ."
  },
  "keywords": [
    "nix",
    "flake",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
